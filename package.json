{
  "name": "@akinozgen17/datagrids",
  "version": "0.1.0",
  "description": "Framework-agnostic, zero-dependency, accessible data grid. Composable modules, server-side ready, and a design no host CSS can break.",
  "keywords": [
    "datagrid",
    "datatable",
    "data-table",
    "table",
    "grid",
    "server-side",
    "laravel",
    "vanilla",
    "framework-agnostic",
    "accessible"
  ],
  "homepage": "https://akinozgen.github.io/datagrids/",
  "bugs": {
    "url": "https://github.com/akinozgen/datagrids/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akinozgen/datagrids.git"
  },
  "license": "MIT",
  "author": "Akın Özgen <akinozgen17@outlook.com>",
  "type": "module",
  "main": "./dist/datagrids.cjs",
  "module": "./dist/datagrids.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/datagrids.js",
      "require": "./dist/datagrids.cjs"
    },
    "./css": "./dist/datagrids.css",
    "./css/tokens": "./dist/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "docs/llm.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build && tsc && node scripts/build-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs --port 4174",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4174",
    "docs:verify": "node scripts/verify-docs.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.64.1",
    "@types/jquery": "^3.5.34",
    "@types/node": "^24.19.2",
    "jquery": "^3.7.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.0.5"
  }
}
